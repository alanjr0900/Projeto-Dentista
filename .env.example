# ==============================================================================
# dentista-app — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# Tudo abaixo funciona SEM credenciais: a integração apenas fica desligada.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de dados (SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Autenticação do painel admin
# ------------------------------------------------------------------------------
# Senha de login do painel (em texto puro; é hasheada no primeiro uso)
ADMIN_PASSWORD="troque-por-uma-senha-forte"
# Secret para assinar os cookies de sessão (gere: openssl rand -base64 32)
AUTH_SECRET="gere-com-openssl-rand-base64-32"

# URL do painel administrativo (endereço próprio, não óbvio).
# Regras: um único segmento, começando com "/". NÃO use "/admin" —
# a rota antiga /admin responde 404 de propósito.
# Para trocar o endereço, mude aqui e reinicie o servidor.
ADMIN_PATH="/painel-dra-luciana"
# Limite de tentativas de login (bloqueio temporário após N erros)
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# ------------------------------------------------------------------------------
# Identidade do site (não sensível; só usada como fallback inicial)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLINICA_NOME="Consultório Dra. [Nome da Dentista]"

# Timezone (fixo: São Paulo não tem horário de verão desde 2019)
TZ="America/Sao_Paulo"

# ------------------------------------------------------------------------------
# GOOGLE CALENDAR — fonte dos horários livres (conta de serviço)
# Deixe vazio para usar apenas a agenda do banco (fallback).
#
# Passo a passo resumido (detalhado no README.md):
#   1. Crie um projeto no Google Cloud Console
#   2. Ative a "Google Calendar API"
#   3. Crie uma CONTA DE SERVIÇO, gere uma chave JSON
#   4. Compartilhe o calendário da doutora com o e-mail da conta de serviço
#      como "editor" (Google Agenda → Configurações → Compartilhar)
# ------------------------------------------------------------------------------
# ID do calendário: o e-mail do calendário (ex.: doutora@gmail.com) ou um
# calendarId de calendário secundário (axxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=""
# E-mail da conta de serviço: algo como nome@projeto-id.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=""
# Chave privada do JSON baixado: cole tudo entre aspas, mantendo os \n literais,
# ex.: GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# E-MAIL — confirmação/cancelamento de consulta (Nodemailer, SMTP genérico)
# Deixe vazio para enviar e-mails silenciosamente (nada é enviado).
# Exemplo Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER é o
# e-mail, SMTP_PASS é uma "senha de app" (Google Account → Security → App passwords).
# Funciona também com Resend ("smtp.resend.com":587), SendGrid, Brevo, etc.
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Remetente exibido: "Consultório <agenda@seudominio.com.br>" ou só o e-mail
SMTP_FROM=""

# ------------------------------------------------------------------------------
# URL pública base — usada nos links de cancelar/remarcar enviados por e-mail
# Em produção, coloque a URL real do site (ex.: "https://www.seudominio.com.br")
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL="http://localhost:3000"
